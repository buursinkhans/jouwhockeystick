  "dependencies": {
    "next": "16.3.6",
    "posthog-js": "^1.438.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
